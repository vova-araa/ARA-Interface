<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ara.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/watchdog.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>ARA_TOKEN</key>
    <string>__ARA_TOKEN__</string>
    <key>ARA_TELEGRAM_BOT_TOKEN</key>
    <string>__TG_TOKEN__</string>
    <key>ARA_TELEGRAM_CHAT_ID</key>
    <string>__TG_CHAT__</string>
    <!-- Beide standaard leeg = uit. Ze laten werk draaien dat niet vanaf deze
         Mac gestart is, dus de eigenaar zet ze zelf op 1 wanneer hij dat wil. -->
    <key>ARA_AUTO_UPDATE</key>
    <string>__AUTO_UPDATE__</string>
    <key>ARA_INBOX</key>
    <string>__INBOX__</string>
    <key>ARA_RHYTHM</key>
    <string>__RHYTHM__</string>
    <key>ARA_RHYTHM_VENTURES</key>
    <string>__RHYTHM_VENTURES__</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOGS__/ara-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/ara-watchdog.err.log</string>
</dict>
</plist>
