<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ara.collector</string>
  <!-- caffeinate -s houdt de Mac wakker zolang de collector draait; anders
       valt de hele wereld stil zodra het deksel dicht gaat of de energiestand
       toeslaat, en dat ziet er van buiten uit als "er gebeurt niets". -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>__PNPM__</string>
    <string>--filter</string>
    <string>@ara/collector</string>
    <string>start</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>ARA_TOKEN</key>
    <string>__ARA_TOKEN__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOGS__/ara-collector.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/ara-collector.err.log</string>
</dict>
</plist>
