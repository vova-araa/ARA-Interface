{
  "policy": {
    "managers": "on-demand",
    "autonomy": "branch-and-report",
    "reporting": "escalate-direct-plus-daily",
    "branchPrefix": "ara/",
    "tokenBudgetDaily": 2000000,
    "repoRoot": "~/dev",
    "hiddenVentures": [
      "misc"
    ],
    "models": {
      "supervisor": "default",
      "manager": "default",
      "worker": "haiku-first (upgrade alleen na aantoonbaar falen)",
      "scout": "haiku"
    },
    "tokenRules": [
      "Grep/Glob vóór Read; lees fragmenten (offset/limit), nooit hele grote bestanden",
      "Bordresultaten max 5 regels; logs/dumps blijven in bestanden, nooit in prompts of resultaten",
      "Spawn-prompts bevatten alleen taak + paden + acceptatiecriteria, geen gespreksgeschiedenis",
      "Polling en statuschecks via curl (0 tokens), nooit via een agent",
      "Één gevalideerde poging boven drie speculatieve; herhaal nooit een read die je al deed"
    ],
    "budgets": {
      "maxManagers": 3,
      "supervisorConcurrent": 6,
      "supervisorTotal": 12,
      "managerConcurrent": 4,
      "managerTotal": 8
    }
  },
  "chief": {
    "agent": "ara-chief",
    "role": "Enige gesprekspartner van de gebruiker (/ara). Intake voor taken, planning (assignee 'gepland' + due-datum), nieuwe agent-rollen, org- en monitorwijzigingen. Spawnt alleen de supervisor; keten blijft intact.",
    "command": "/ara <bericht>"
  },
  "ops": {
    "manager": "manager:ops",
    "standing": true,
    "spawnedBy": "watchdog (scripts/watchdog.mjs, launchd elke 5 min, 0 tokens)",
    "focus": "Incidenten: sites offline, glitches, kapotte services. Operationele fixes direct; codefixes op ara/incident-* branches; escalatieketen manager:ops → supervisor (feedback + 1 herkansing) → mens.",
    "monitors": "plugins/ara/monitors.json"
  },
  "ventures": [
    {
      "id": "traject",
      "manager": "manager:traject",
      "priority": 1,
      "focus": "Sharzi TMS: ritten plannen, facturatie, transport-integraties. Productie-gevoelig: migraties en externe API's altijd escaleren."
    },
    {
      "id": "blex",
      "manager": "manager:blex",
      "priority": 1,
      "focus": "Truck & Trailers: wagenparkbeheer, voorraad/trailers, Supabase-sync. Data-integriteit boven snelheid."
    },
    {
      "id": "uprising",
      "manager": "manager:uprising",
      "priority": 1,
      "focus": "Studio: site, boekingen, audio-tooling. Visueel werk graag met screenshot in het taakresultaat."
    },
    {
      "id": "trading",
      "manager": "manager:trading",
      "priority": 1,
      "focus": "XAU/USD bots: STRIKT read-only op live trading; elke wijziging aan order-logica of keys is een automatische ESCALATE."
    },
    {
      "id": "elevate",
      "manager": "manager:elevate",
      "priority": 2,
      "focus": "Design: campagnes, assets, sites."
    },
    {
      "id": "vovara",
      "manager": "manager:vovara",
      "priority": 2,
      "focus": "Muziek: releases, site, promotie."
    },
    {
      "id": "crypto",
      "manager": "manager:crypto",
      "priority": 1,
      "focus": "Crypto desk: munten volgen, setups bewaken, on-chain data. STRIKT read-only op live posities; elke order-wijziging is een automatische ESCALATE."
    }
  ],
