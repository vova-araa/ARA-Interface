{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-collector.sh\"", "timeout": 5 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" SessionStart" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" SessionEnd" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/usage.sh\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" UserPromptSubmit" }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" PreToolUse" }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" PostToolUse" }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" SubagentStart" }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" SubagentStop" }] }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" Stop" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/usage.sh\"" }
        ]
      }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" Notification" }] }
    ],
    "TaskCompleted": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" TaskCompleted" }] }
    ],
    "TeammateIdle": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" TeammateIdle" }] }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" PostToolUseFailure" }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" PermissionRequest" }] }
    ],
    "PermissionDenied": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" PermissionDenied" }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" PreCompact" }] }
    ],
    "PostCompact": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" PostCompact" }] }
    ],
    "PostModelSwitch": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" PostModelSwitch" }] }
    ],
    "PostToolBatch": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" PostToolBatch" }] }
    ],
    "WorktreeCreate": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" WorktreeCreate" }] }
    ],
    "WorktreeRemove": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" WorktreeRemove" }] }
    ],
    "TaskCreated": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/emit.sh\" TaskCreated" }] }
    ]
  }
}
